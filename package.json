{
  "name": "lofi-terminal",
  "version": "0.1.0",
  "description": "Claude Code on a 90s CRT in a cozy lo-fi bedroom",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jamie.lofiterminal",
    "productName": "Lo-Fi Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LoFi-Terminal-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "LoFi-Terminal-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "LoFi-Terminal-Portable-${version}.${ext}"
    }
  }
}
